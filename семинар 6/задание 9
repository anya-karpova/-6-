a = int(input("введите пожалуйста число 1:"))
b = int(input("введите пожалуйста число 2:"))
c = int(input("введите пожалуйста число 3:"))
p = (a + b + c) / 2
s = (p * (p - a) * (p - b) * (p - c)) ** 0.5
print("площадь треугольника: ", s)
if s % 2 == 0:
    print("число четное")
else:
    print("число нечетное")