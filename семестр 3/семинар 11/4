import random
def chislo():
    zagadano = random.randint(1, 100) #загадываем рандом число

    for i in range(10): #10 попыток считаем
        polsovatel = int(input())
        if polsovatel < zagadano:
            print('число больше, чем вы написали')
        elif polsovatel > zagadano:
            print('число меньше, чем вы написали')   
        else:
            print('вы угадали!')
            break    
print(chislo())        