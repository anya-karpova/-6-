'''Реализуйте в виде функции игру “Угадай число”. Пользователю дается 10 попыток угадать 
заданное случайное число в диапазоне от 1 до 100. При каждой попытке программа должна оповещать 
игрока, загаданное число больше, меньше или равно введенного.'''
import random
def chislo():
    zagadano = random.randint(1, 100) #загадываем рандом число

    for i in range(10): #10 попыток считаем
        polsovatel = int(input('введите пожалуйста число: '))
        if polsovatel < zagadano:
            print('число больше, чем вы написали')
        elif polsovatel > zagadano:
            print('число меньше, чем вы написали')   
        else:
            print('вы угадали!')
            break    
print(chislo())        